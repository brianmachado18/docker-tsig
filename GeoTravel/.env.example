# ----------------------------
# Postgres / PostGIS
# ----------------------------
POSTGRES_DB=tsig
POSTGRES_USER=tsig
POSTGRES_PASSWORD=tsig

# ----------------------------
# GeoServer
# ----------------------------
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver

# ----------------------------
# Backend (Spring)
# ----------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tsig
SPRING_DATASOURCE_USERNAME=tsig
SPRING_DATASOURCE_PASSWORD=tsig
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
GEOSERVER_URL=http://geoserver:8080/geoserver

# ----------------------------
# Frontend (Vite)
# ----------------------------
VITE_API_URL=/api
VITE_GEOSERVER_URL=/geoserver
VITE_GEOSERVER_WORKSPACE=geotravel
VITE_USE_MOCKS=false
VITE_API_PROXY_TARGET=http://backend:8080
VITE_GEOSERVER_PROXY_TARGET=http://geoserver:8080

# ----------------------------
# Host Ports (docker-compose)
# ----------------------------
POSTGRES_PORT=5433
BACKEND_PORT=8080
GEOSERVER_PORT=8081
TOMCAT_PORT=8082
FRONTEND_PORT=5173
