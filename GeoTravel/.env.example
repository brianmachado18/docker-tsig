# ----------------------------
# Postgres / PostGIS
# ----------------------------
POSTGRES_DB=tsig
POSTGRES_USER=tsig
POSTGRES_PASSWORD=tsig

# ----------------------------
# GeoServer
# ----------------------------
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
GEOSERVER_REST_URL=http://geoserver:8080/geoserver/rest
GEOSERVER_DATASTORE=postgis

# ----------------------------
# Backend (Spring en Tomcat)
# ----------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tsig
SPRING_DATASOURCE_USERNAME=tsig
SPRING_DATASOURCE_PASSWORD=tsig
SPRING_JPA_HIBERNATE_DDL_AUTO=update
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOCODING_IDE_BASE_URL=https://direcciones.ide.uy
GEOCODING_IDE_USER_AGENT=GeoTravel/1.0 (tsig local project)
GEOCODING_IDE_REQUEST_TIMEOUT_MS=10000
GEOCODING_IDE_INSECURE=true

# ----------------------------
# Frontend (Vite)
# ----------------------------
VITE_API_URL=/tsig-backend
VITE_GEOSERVER_URL=/geoserver
VITE_GEOSERVER_WORKSPACE=geotravel
VITE_USE_MOCKS=false
VITE_API_PROXY_TARGET=http://tomcat:8080
VITE_GEOSERVER_PROXY_TARGET=http://geoserver:8080

# ----------------------------
# Host Ports (docker-compose)
# ----------------------------
POSTGRES_PORT=5433
GEOSERVER_PORT=8081
TOMCAT_PORT=8082
FRONTEND_PORT=5173
